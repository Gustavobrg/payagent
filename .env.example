AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# OpenRouter — used only by scripts/generate_dataset.py (synthetic eval dataset generation,
# outside the agent's runtime). https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
LLAMA_GUARD_MODEL=llama-guard3:1b
QDRANT_URL=http://localhost:6333
# Langfuse Cloud (not self-hosted) — https://cloud.langfuse.com or your region (EU/US)
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Mandate signing key (Ed25519). Generate locally; production uses Key Vault.
MANDATE_SIGNING_KEY_PATH=./.keys/mandate_ed25519.pem
POLICY_MAX_AMOUNT_CENTS=50000
POLICY_STEPUP_THRESHOLD_CENTS=100000
