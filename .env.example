AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
# OpenRouter — used by scripts/generate_dataset.py (synthetic eval dataset generation) and
# by OpenRouterLlamaGuard (guardrails/provider.py), which scripts/probe_llama_guard.py uses
# to calibrate the taxonomy. Neither is on the agent's live runtime path. https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434
LLAMA_GUARD_MODEL=llama-guard3:1b
QDRANT_URL=http://localhost:6333
# Langfuse Cloud (not self-hosted) — https://cloud.langfuse.com or your region (EU/US)
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Mandate signing key (Ed25519). Generated locally on first run if the file doesn't exist yet;
# production uses Key Vault.
MANDATE_SIGNING_KEY_PATH=./.keys/mandate_ed25519.pem
# POL-001: hard ceiling per transaction.
POLICY_MAX_AMOUNT_CENTS=50000
# POL-003: step-up (WebAuthn/passkey) required above this amount.
POLICY_STEPUP_THRESHOLD_CENTS=100000
# POL-002: sum of successful settlements in the trailing 24h must not exceed this.
POLICY_DAILY_AGGREGATE_LIMIT_CENTS=200000
# POL-005: comma-separated merchant_ids authorized for settlement. Matches evals/datasets/catalog.json.
POLICY_MERCHANT_ALLOWLIST=MERCH-01,MERCH-02,MERCH-03,MERCH-04,MERCH-05,MERCH-06,MERCH-07,MERCH-08,MERCH-09,MERCH-10,MERCH-11,MERCH-12,MERCH-13,MERCH-14,MERCH-15
# POL-004: comma-separated categories denied regardless of amount.
POLICY_RESTRICTED_CATEGORIES=alcoholic beverages,jewelry and luxury watches,gift cards and vouchers
